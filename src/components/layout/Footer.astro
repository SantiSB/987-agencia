---
/**
 * Footer — closing block on ink background: logo lockup, claim, social links,
 * copyright and the brand's sign-off. Content is data-driven from site.ts.
 */
import Container from '@/components/primitives/Container.astro';
import { Icon } from '@/components/primitives/Icon';
import { site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-bone-100">
  <Container class="py-16">
    <div class="flex flex-col gap-12 md:flex-row md:items-start md:justify-between">
      <!-- Brand -->
      <div class="max-w-sm">
        <div class="flex items-baseline gap-2">
          <span class="font-display text-4xl leading-none text-bone-50">978</span>
          <span class="font-sans text-xs uppercase tracking-[0.24em] text-bone-300">
            {site.brand.tagline}
          </span>
        </div>
        <p class="mt-4 font-accent text-2xl italic text-accent-300">
          {site.brand.solution}
        </p>
        <p class="mt-2 text-sm text-bone-300">{site.brand.claim}</p>
      </div>

      <!-- Nav + socials -->
      <div class="flex flex-col gap-8 sm:flex-row sm:gap-16">
        <nav aria-label="Pie de página">
          <h2 class="mb-4 font-sans text-xs uppercase tracking-[0.2em] text-bone-300">
            Navegación
          </h2>
          <ul class="space-y-2">
            {
              site.nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-sm text-bone-100 transition-colors hover:text-accent"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <h2 class="mb-4 font-sans text-xs uppercase tracking-[0.2em] text-bone-300">Redes</h2>
          <ul class="flex gap-3">
            {
              site.socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={social.label}
                    class="flex h-11 w-11 items-center justify-center rounded-sm border border-ink-600 text-bone-100 transition-all duration-200 hover:border-accent hover:text-accent"
                  >
                    <Icon name={social.icon} size={20} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-ink-600 pt-6 text-xs text-bone-300 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.brand.name}. {site.brand.city}.</p>
      <p class="font-accent text-sm italic text-bone-100">{site.brand.solution}</p>
    </div>
  </Container>
</footer>
