---
/**
 * BootcampLogistics — quick reassurance strip (fecha, lugar, modalidad,
 * cupos) placed right before the FAQ/final CTA, where buyers double-check
 * details before committing. Static Astro markup, no client JS needed.
 */
import Container from '@/components/primitives/Container.astro';
import { Icon } from '@/components/primitives/Icon';
import { site } from '@/config/site';
import type { IconName } from '@/lib/icons';

const { logistics } = site.bootcamp;
---

<section class="border-y border-bootcamp-line bg-bootcamp-surface py-14 text-bootcamp-white">
  <Container>
    <h2 class="text-center font-display text-2xl uppercase tracking-tight text-bootcamp-white md:text-3xl">
      {logistics.heading}
    </h2>
    <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-4">
      {
        logistics.items.map((item) => (
          <li class="flex items-start gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-bootcamp-line text-bootcamp-yellow">
              <Icon name={item.icon as IconName} size={18} strokeWidth={1.6} />
            </span>
            <span>
              <span class="block text-xs uppercase tracking-[0.16em] text-bootcamp-white/60">
                {item.label}
              </span>
              <span class="block text-sm text-bootcamp-white">{item.value}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
