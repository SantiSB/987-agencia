---
/**
 * BootcampVideo — "así se vive el Bootcamp 978" video slot, immediately after
 * the hero. Native <video>: no JS island needed, just controls + a poster so
 * nothing downloads until the visitor presses play.
 */
import Container from '@/components/primitives/Container.astro';
import { site } from '@/config/site';

const { video } = site.bootcamp;
---

<section class="bg-bootcamp-carbon py-section-sm text-bootcamp-white">
  <Container class="max-w-4xl">
    <h2 class="text-center font-display uppercase leading-[0.95] tracking-tight text-[clamp(1.5rem,4.5vw,2.5rem)]">
      {video.heading}
    </h2>
    <div class="mt-8">
      <video
        src={video.src}
        poster={video.poster}
        controls
        preload="none"
        playsinline
        width={1280}
        height={720}
        class="aspect-video w-full rounded-md border border-bootcamp-line"
      />
    </div>
  </Container>
</section>
