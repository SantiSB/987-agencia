---
/**
 * BootcampHero (#inicio) — conversion hero on the event's black/yellow
 * sub-brand. Loss-aversion copy (hook + subhook), a compact preventa countdown
 * and a micro-trust line under the CTAs. The headline is plain Astro markup so
 * it paints as the LCP; the countdown hydrates as an island.
 */
import Container from '@/components/primitives/Container.astro';
import { Button } from '@/components/primitives/Button';
import { Boxed } from '@/components/primitives/SectionHeading';
import { Icon } from '@/components/primitives/Icon';
import { CountdownTimer } from '@/components/bootcamp/CountdownTimer';
import { site } from '@/config/site';

const { hero, urgencia } = site.bootcamp;
---

<section
  id="inicio"
  class="relative overflow-hidden bg-bootcamp-black pb-20 pt-32 text-bootcamp-white md:pb-28 md:pt-40"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[34rem] bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,var(--color-bootcamp-glow),transparent)]"
    aria-hidden="true"
  >
  </div>

  <Container class="relative z-10">
    <div class="flex items-center justify-between border-b border-bootcamp-line pb-4 text-xs uppercase tracking-[0.3em] text-bootcamp-white/70">
      <span>2026</span>
      <span>Emprender</span>
    </div>

    <div class="mx-auto mt-12 max-w-4xl text-center">
      <span
        class="inline-flex items-center gap-2 rounded-sm border border-bootcamp-yellow/50 px-3 py-1 font-sans text-xs font-semibold uppercase tracking-[0.2em] text-bootcamp-yellow"
      >
        {hero.badge}
      </span>

      <p class="mt-6 font-sans text-sm uppercase tracking-[0.3em] text-bootcamp-white/70">
        {hero.kicker}
      </p>

      <h1 class="mt-4 font-display uppercase leading-[0.88] tracking-tight text-[clamp(3rem,12vw,7rem)]">
        {hero.title}
      </h1>

      <p class="mt-6 font-accent text-2xl italic text-bootcamp-yellow md:text-3xl">
        {hero.accent}
      </p>

      <!-- Brand hook — boxed framing line -->
      <p class="mt-8 font-display text-xl uppercase leading-tight tracking-tight md:text-2xl">
        <Boxed tone="accent" className="bg-bootcamp-yellow text-bootcamp-black">{hero.hook}</Boxed>
      </p>

      <p class="mx-auto mt-6 max-w-xl text-base text-bootcamp-white/70 md:text-lg">
        {hero.subhook}
      </p>

      <div class="mt-9">
        <CountdownTimer
          client:load
          targetDate={urgencia.fechaCierrePreventa}
          variant="compacto"
          label={hero.countdownLabel}
        />
      </div>

      <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button
          href={hero.ctaPrimary.href}
          size="lg"
          className="bg-bootcamp-yellow text-bootcamp-black hover:bg-bootcamp-yellow-600 hover:shadow-none"
        >
          {hero.ctaPrimary.label}
          <Icon name="arrowRight" size={18} />
        </Button>
        <Button
          href={hero.ctaSecondary.href}
          variant="outline"
          size="lg"
          className="border-bootcamp-white/40 text-bootcamp-white hover:bg-bootcamp-white hover:text-bootcamp-black"
        >
          {hero.ctaSecondary.label}
        </Button>
      </div>

      <p class="mt-6 text-xs uppercase tracking-[0.16em] text-bootcamp-white/50">
        {hero.microConfianza}
      </p>
    </div>
  </Container>
</section>
