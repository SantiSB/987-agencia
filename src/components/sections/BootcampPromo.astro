---
/**
 * BootcampPromo — flagship homepage banner for the Bootcamp 978 event, on its
 * own black/yellow sub-brand so it reads as a distinct live event, not just
 * another service section. Sits right after the Hero (highest-visibility slot)
 * and links out to the full /bootcamp landing. The countdown is the one
 * hydrated island here; everything else is static markup for a fast paint.
 */
import Container from '@/components/primitives/Container.astro';
import { Button } from '@/components/primitives/Button';
import { Icon } from '@/components/primitives/Icon';
import { CountdownTimer } from '@/components/bootcamp/CountdownTimer';
import { site } from '@/config/site';

const { bootcampPromo } = site;
const { event, urgencia } = site.bootcamp;
---

<section class="relative overflow-hidden bg-bootcamp-black py-section-sm text-bootcamp-white">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[28rem] bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,var(--color-bootcamp-glow),transparent)]"
    aria-hidden="true"
  >
  </div>

  <Container class="relative z-10">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <!-- Copy -->
      <div class="text-center lg:text-left">
        <span
          class="inline-flex items-center gap-2 rounded-sm border border-bootcamp-yellow/50 px-3 py-1 font-sans text-xs font-semibold uppercase tracking-[0.2em] text-bootcamp-yellow"
        >
          {bootcampPromo.badge}
        </span>

        <p class="mt-5 font-sans text-xs uppercase tracking-[0.3em] text-bootcamp-white/70">
          {bootcampPromo.kicker}
        </p>

        <h2 class="mt-3 font-display uppercase leading-[0.88] tracking-tight text-[clamp(2.5rem,8vw,5rem)]">
          {bootcampPromo.title}
        </h2>

        <p class="mt-3 font-accent text-2xl italic text-bootcamp-yellow md:text-3xl">
          {bootcampPromo.accent}
        </p>

        <p class="mx-auto mt-5 max-w-md text-base text-bootcamp-white/70 md:text-lg lg:mx-0">
          {bootcampPromo.subtitle}
        </p>

        <!-- Quick facts -->
        <ul class="mx-auto mt-7 flex max-w-md flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-bootcamp-white/80 lg:mx-0 lg:justify-start">
          <li class="flex items-center gap-2">
            <Icon name="clock" size={16} className="text-bootcamp-yellow" />
            {event.dateLabel}
          </li>
          <li class="flex items-center gap-2">
            <Icon name="mapPin" size={16} className="text-bootcamp-yellow" />
            {event.venue}, {event.city}
          </li>
        </ul>

        <div class="mt-8 flex justify-center lg:justify-start">
          <CountdownTimer
            client:visible
            targetDate={urgencia.fechaCierrePreventa}
            variant="compacto"
            label="La preventa cierra en"
          />
        </div>

        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row lg:justify-start">
          <Button
            href={bootcampPromo.cta.href}
            size="lg"
            className="bg-bootcamp-yellow text-bootcamp-black hover:bg-bootcamp-yellow-600 hover:shadow-none"
          >
            {bootcampPromo.cta.label}
            <Icon name="arrowRight" size={18} />
          </Button>
          <span class="text-xs uppercase tracking-[0.16em] text-bootcamp-white/50">
            {urgencia.etiquetaEscasez}
          </span>
        </div>
      </div>

      <!-- Flyer -->
      <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
        <div
          class="pointer-events-none absolute -inset-4 rounded-lg bg-[radial-gradient(ellipse_60%_60%_at_50%_40%,var(--color-bootcamp-glow),transparent)] blur-2xl"
          aria-hidden="true"
        >
        </div>
        <a
          href={bootcampPromo.cta.href}
          class="group relative block"
          aria-label={`${bootcampPromo.cta.label} — ${event.dateLabel}`}
        >
          <img
            src="/flyer/bootcamp-978-flyer.webp"
            alt="Flyer oficial Bootcamp 978 — Marketing a la Mano"
            width={800}
            height={1000}
            loading="eager"
            fetchpriority="high"
            class="w-full rounded-md border border-bootcamp-yellow/30 shadow-[0_0_60px_-12px_var(--color-bootcamp-glow)] transition-transform duration-300 ease-out group-hover:-translate-y-1"
          />
          <span
            aria-hidden="true"
            class="absolute -right-3 -top-3 flex items-center gap-1 rounded-sm bg-bootcamp-yellow px-3 py-1.5 font-sans text-xs font-bold uppercase tracking-[0.14em] text-bootcamp-black shadow-card"
          >
            {event.dateLabel}
          </span>
        </a>
      </div>
    </div>
  </Container>
</section>
