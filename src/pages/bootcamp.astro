---
/**
 * bootcamp.astro — conversion landing (one-pager) for Bootcamp 978 · Marketing
 * a la Mano. Sales run through PassTix (checkout links); WhatsApp is for
 * questions only. Section order follows the conversion architecture in the
 * client brief, alternating black / carbon / cream backgrounds for rhythm.
 *
 * Island strategy: static Astro sections (hero, video, quick facts) stay
 * JS-free; interactive React sections hydrate on visibility to keep initial JS
 * light. The sticky CTA and WhatsApp float hydrate eagerly (client:load).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Navbar } from '@/components/layout/Navbar';
import Footer from '@/components/layout/Footer.astro';
import BootcampHero from '@/components/sections/bootcamp/BootcampHero.astro';
import BootcampVideo from '@/components/sections/bootcamp/BootcampVideo.astro';
import BootcampQuickFacts from '@/components/sections/bootcamp/BootcampQuickFacts.astro';
import { BootcampAuthority } from '@/components/sections/bootcamp/BootcampAuthority';
import { BootcampPromise } from '@/components/sections/bootcamp/BootcampPromise';
import { BootcampAudience } from '@/components/sections/bootcamp/BootcampAudience';
import { BootcampExperience } from '@/components/sections/bootcamp/BootcampExperience';
import { BootcampCurriculum } from '@/components/sections/bootcamp/BootcampCurriculum';
import { PricingBlock } from '@/components/bootcamp/PricingBlock';
import { BootcampValue } from '@/components/sections/bootcamp/BootcampValue';
import { BootcampTeam } from '@/components/sections/bootcamp/BootcampTeam';
import { BootcampSocialProof } from '@/components/sections/bootcamp/BootcampSocialProof';
import { BootcampVenue } from '@/components/sections/bootcamp/BootcampVenue';
import { BootcampFaq } from '@/components/sections/bootcamp/BootcampFaq';
import { BootcampClose } from '@/components/sections/bootcamp/BootcampClose';
import { BootcampStickyCta } from '@/components/sections/bootcamp/BootcampStickyCta';
import { BootcampWhatsappFloat } from '@/components/sections/bootcamp/BootcampWhatsappFloat';
import { site } from '@/config/site';

const { bootcamp } = site;
const { pricing } = bootcamp;
---

<BaseLayout title={bootcamp.seo.title} description={bootcamp.seo.description}>
  <Navbar client:load dark />
  <main id="contenido" class="pb-20 md:pb-24">
    <BootcampHero />
    <BootcampVideo />
    <BootcampQuickFacts />
    <BootcampAuthority client:visible />
    <BootcampPromise client:visible />
    <BootcampAudience client:visible />
    <BootcampExperience client:visible />
    <BootcampCurriculum client:visible />
    <PricingBlock client:visible id="precios" heading={pricing.heading1} />
    <BootcampValue client:visible />
    <BootcampTeam client:visible />
    <BootcampSocialProof client:visible />
    <BootcampVenue client:visible />
    <BootcampFaq client:visible />
    <PricingBlock client:visible id="precios-final" heading={pricing.heading2} />
    <BootcampClose client:visible />
  </main>
  <Footer>
    <a
      slot="credit"
      href="https://passtix.co"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 text-bone-300 transition-colors hover:text-bone-50"
    >
      <span>Sitio y venta de entradas por</span>
      <span class="font-semibold tracking-wide text-bone-50">PassTix</span>
      <span aria-hidden="true">·</span>
      <span>tu tiquetera oficial</span>
    </a>
  </Footer>

  <BootcampStickyCta client:load />
  <BootcampWhatsappFloat client:load />
</BaseLayout>
